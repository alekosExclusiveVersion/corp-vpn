<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradesoft.corp-wifi-routes</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/usr/local/sbin/corp-wifi-routes.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/log/corp-wifi-routes.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/corp-wifi-routes.stderr.log</string>
    <key>WorkingDirectory</key>
    <string>/usr/local/sbin</string>
</dict>
</plist>
